{
  "name": "cz-emoji-conventional",
  "version": "1.2.2",
  "description": "commitizen adapter for conventional commit messages with emoji",
  "repository": {
    "type": "git",
    "url": "https://github.com/promet99/cz-emoji-conventional.git"
  },
  "bugs": {
    "url": "https://github.com/promet99/cz-emoji-conventional/issues"
  },
  "main": "build/index.js",
  "scripts": {
    "commit": "cz",
    "lint": "eslint .",
    "build": "tsc",
    "test": "node --test test/*.test.mjs"
  },
  "author": "Promet99 (https://github.com/promet99)",
  "license": "ISC",
  "keywords": [
    "commitizen",
    "conventional-commit",
    "adapter",
    "emoji"
  ],
  "config": {
    "commitizen": {
      "path": "./build/index.js"
    }
  },
  "husky": {
    "hooks": {
      "prepare-commit-msg": "exec < /dev/tty && git cz --hook || true"
    }
  },
  "dependencies": {
    "chalk": "4.1.2",
    "commitizen": "^4.3.2",
    "word-wrap": "^1.2.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^26.4.1",
    "eslint": "^9.39.5",
    "eslint-plugin-import": "^2.32.0",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "prettier": "^3.9.6",
    "pretty-quick": "^4.2.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.69.0"
  }
}
