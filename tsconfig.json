{
  "compilerOptions": {
    "target": "es2022",
    "lib": [
      "es2022"
    ],
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "noFallthroughCasesInSwitch": true,
    "outDir": "build",
    "module": "node16",
    "rootDir": "src",
    "types": [
      "node"
    ],
    "declaration": true
  },
  "include": [
    "src/**/*.ts",
    "./modules.d.ts"
  ],
  "exclude": [
    "node_modules",
    "build"
  ]
}
